{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DirectHTTPTransport",
  "description": "A one-time direct-http description. The client fetches one HTTPS muxed stream from the source with only the fixed header whitelist.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "streams"
  ],
  "properties": {
    "kind": {
      "const": "direct-http"
    },
    "source_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "streams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "stream.schema.json"
          },
          {
            "properties": {
              "role": {
                "const": "muxed"
              },
              "url": {
                "pattern": "^https://[^\\s]+$"
              }
            }
          }
        ]
      }
    },
    "subtitles": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "subtitle.schema.json"
      }
    }
  }
}
