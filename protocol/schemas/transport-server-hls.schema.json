{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerHLSTransport",
  "description": "A server-hosted HLS media session. Source credentials and headers stay on the server, and the media-session capability appears only in the playlist URL path. Deliverable text subtitles are issued only as WebVTT under the same media-session path and a separate ss_ capability; PGS is omitted from the S3 server-HLS list.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "media_session",
    "streams"
  ],
  "properties": {
    "kind": {
      "const": "server-hls"
    },
    "media_session": {
      "$ref": "media-session.schema.json"
    },
    "streams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "stream.schema.json"
          },
          {
            "properties": {
              "role": {
                "const": "muxed"
              },
              "url": {
                "pattern": "^https://[^\\s?#]+/api/v1/playback/media-sessions/ms_[A-Za-z0-9_-]{22,96}/index\\.m3u8$"
              },
              "mime": {
                "const": "application/vnd.apple.mpegurl"
              },
              "headers": {
                "maxProperties": 0
              }
            }
          }
        ]
      }
    },
    "subtitles": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "allOf": [
          {
            "$ref": "subtitle.schema.json"
          },
          {
            "required": [
              "url"
            ],
            "properties": {
              "format": {
                "const": "vtt"
              },
              "url": {
                "pattern": "^https://[^\\s?#]+/api/v1/playback/media-sessions/ms_[A-Za-z0-9_-]{22,96}/subtitle-sessions/ss_[A-Za-z0-9_-]{22,96}\\.vtt$"
              }
            }
          }
        ]
      }
    }
  }
}
