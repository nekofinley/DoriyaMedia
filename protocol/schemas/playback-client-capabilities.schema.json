{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlaybackClientCapabilities",
  "description": "Client-declared playback capabilities. These values can only narrow server eligibility; they never authorize a file or force a transport.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platform",
    "version",
    "engine",
    "containers",
    "video_codecs",
    "audio_codecs",
    "subtitle_codecs",
    "supports_range",
    "supports_headers"
  ],
  "properties": {
    "platform": {
      "$ref": "device-platform.schema.json"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]*$"
    },
    "engine": {
      "type": "string",
      "enum": [
        "mpv",
        "libmpv",
        "media3"
      ]
    },
    "containers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32,
        "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]*$"
      }
    },
    "video_codecs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]*$"
      }
    },
    "audio_codecs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]*$"
      }
    },
    "subtitle_codecs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "text",
          "ass",
          "pgs"
        ]
      }
    },
    "supports_dash_merge": {
      "type": "boolean",
      "default": false,
      "description": "When true, the client can merge a separate direct-dash video stream and audio stream. Omitting this capability is equivalent to false."
    },
    "supports_range": {
      "type": "boolean"
    },
    "supports_headers": {
      "type": "boolean"
    }
  }
}
