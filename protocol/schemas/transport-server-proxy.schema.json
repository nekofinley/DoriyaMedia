{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerProxyTransport",
  "description": "A server-hosted media session that proxies source bytes without exposing source credentials. The media-session capability appears only in the stream URL path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "media_session",
    "streams"
  ],
  "properties": {
    "kind": {
      "const": "server-proxy"
    },
    "media_session": {
      "$ref": "media-session.schema.json"
    },
    "streams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "stream.schema.json"
          },
          {
            "properties": {
              "role": {
                "const": "muxed"
              },
              "url": {
                "pattern": "^https://[^\\s?#]+/api/v1/playback/media-sessions/ms_[A-Za-z0-9_-]{22,96}/stream$"
              },
              "headers": {
                "maxProperties": 0
              }
            }
          }
        ]
      }
    },
    "subtitles": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "subtitle.schema.json"
      }
    }
  }
}
