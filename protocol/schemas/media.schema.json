{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MediaSummary",
  "description": "Source media metadata used by a client to prepare playback.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "container",
    "duration",
    "video",
    "audio"
  ],
  "properties": {
    "container": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]*$"
    },
    "duration": {
      "type": "number",
      "minimum": 0
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codec"
      ],
      "properties": {
        "codec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]*$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "bit_depth": {
          "type": "integer",
          "minimum": 8,
          "maximum": 16
        },
        "hdr": {
          "type": "boolean"
        }
      }
    },
    "audio": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "codec",
          "channels"
        ],
        "properties": {
          "codec": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]*$"
          },
          "channels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "language": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          }
        }
      }
    }
  }
}
