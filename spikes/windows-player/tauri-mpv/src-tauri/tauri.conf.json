{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doriya W0 Tauri mpv",
  "version": "0.1.0",
  "identifier": "media.doriya.w0.tauri-mpv",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Doriya W0 / Tauri + mpv",
        "width": 1180,
        "height": 820,
        "minWidth": 720,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
